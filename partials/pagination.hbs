{{#if pagination}}
    <nav class="pagination" aria-label="Page navigation">
        {{#if prev}}
            <a href="{{page_url prev}}" class="pagination__link pagination__link--prev" rel="prev">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M9 3L5 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Newer
            </a>
        {{else}}
            <span class="pagination__link pagination__link--prev pagination__link--disabled" aria-disabled="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M9 3L5 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Newer
            </span>
        {{/if}}

        <span class="pagination__info">{{page}} / {{pages}}</span>

        {{#if next}}
            <a href="{{page_url next}}" class="pagination__link pagination__link--next" rel="next">
                Older
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        {{else}}
            <span class="pagination__link pagination__link--next pagination__link--disabled" aria-disabled="true">
                Older
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
        {{/if}}
    </nav>
{{/if}}
