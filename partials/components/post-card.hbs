{{!-- Post Card --}}
<article class="post-card {{post_class}}" data-tags="{{#foreach tags}}{{slug}} {{/foreach}}" data-reading-time="{{reading_time minutesOnly="true"}}">

    {{#if feature_image}}
        <a href="{{url}}" class="post-card__image-link" tabindex="-1" aria-hidden="true">
            <div class="post-card__image-wrap">
                <img src="{{img_url feature_image size="m"}}"
                     srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w"
                     sizes="(max-width: 640px) 100vw, 380px"
                     alt="{{feature_image_alt}}"
                     loading="lazy"
                     class="post-card__image">
            </div>
        </a>
    {{/if}}

    <div class="post-card__content">
        <div class="post-card__tags">
            {{#if primary_tag}}
                <a href="{{primary_tag.url}}" class="post-tag">{{primary_tag.name}}</a>
            {{/if}}
            {{#if featured}}
                <span class="badge badge--star badge--xs">★</span>
            {{/if}}
        </div>

        <h2 class="post-card__title">
            <a href="{{url}}">{{title}}</a>
        </h2>

        <p class="post-card__excerpt">{{excerpt words="22"}}</p>

        <div class="post-card__footer">
            <div class="author-mini">
                {{#if primary_author.profile_image}}
                    <img src="{{img_url primary_author.profile_image size="xs"}}"
                         alt="{{primary_author.name}}"
                         class="author-mini__avatar">
                {{/if}}
                <span class="author-mini__name">{{primary_author.name}}</span>
            </div>
            <div class="post-card__meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span>{{reading_time}}</span>
            </div>
        </div>

        <div class="post-card__progress" aria-hidden="true">
            <div class="post-card__progress-fill js-card-progress"></div>
        </div>
    </div>

</article>
