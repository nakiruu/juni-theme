                    <div class="about-hero__links">
                        <a href="https://www.linkedin.com/in/nicolas-zubulidis" target="_blank" rel="noopener" class="about-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
